<?xml version="1.0" encoding="utf-8"?>
<!--
  One checklist row: state dot, text column, action button.

  The dot's fill is set in code (done / pending / blocked) because every surface role in this theme
  is the same pure black — a state that relied on a background tint would be invisible. Same reason
  the row itself gets a minor-tier border programmatically rather than a surface fill.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <View
        android:id="@+id/status_dot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?textAppearanceTitleSmall"
            android:textColor="?colorOnSurface"
            tools:text="1. Allow notifications" />

        <!-- The framework summary id on purpose: ShiroikumaViewTheme treats that id as the dim
             secondary line, so this row is typed and dimmed by the same rule as every other
             secondary line in the app instead of drifting from them. -->
        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?textAppearanceBodySmall"
            android:textColor="?colorOnSurfaceVariant"
            tools:text="Required — the pairing code arrives in a notification" />

        <!-- The row's own red warning, coloured in code like the status dot and for the same
             reason. Inside the row rather than floating above the section: a warning that sits
             outside the box it is about reads as being about the whole section. -->
        <TextView
            android:id="@+id/row_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?textAppearanceBodySmall"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="⚠ Clearing this is not casually reversible." />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/row_action"
        style="@style/CardButton"
        android:layout_marginStart="8dp"
        android:minWidth="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        tools:text="Fix" />

</LinearLayout>
