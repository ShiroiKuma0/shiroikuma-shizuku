<?xml version="1.0" encoding="utf-8"?>
<!-- 白い熊 雫 SUB-category header (one level under a section): indented medium-bold yellow heading
     with a word-width underline. No full-width divider — that marks top-level groups only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="54dp"
    android:paddingTop="10dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/shizuku_yellow"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="2dp"
            android:background="@color/shizuku_yellow" />
    </LinearLayout>
</LinearLayout>
