<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card.Small">

    <ImageView
        android:id="@android:id/icon"
        style="@style/CardIcon.Droplet"
        android:duplicateParentState="true"
        android:importantForAccessibility="yes"
        android:contentDescription="@string/accessibility_icon_server_status"
        android:transitionName="icon_server_status"
        android:src="@drawable/ic_server_error_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <!--
      Vertical LinearLayout for text/chip content.
      Using LinearLayout instead of a nested ConstraintLayout means layout_marginTop
      on child views is always honoured, and the status dot in the title row reliably
      aligns with the first line of text regardless of font scale.
      (The inner ConstraintLayout approach caused overlap on Nothing 4a / Android 16
      with large font scale because marginTop on a top+bottom-constrained view is
      ignored — issue #271.)
    -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/m3e_spacing_large"
        android:layout_marginEnd="16dp"
        android:duplicateParentState="true"
        app:layout_constraintStart_toEndOf="@android:id/icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Status dot + title on one horizontal row, gravity=center_vertical
             so the dot always optically aligns with the text cap-height. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:duplicateParentState="true">

            <View
                android:id="@+id/status_indicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/shape_status_indicator" />

            <TextView
                android:id="@android:id/text1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?textAppearanceTitleLarge"
                android:textColor="?colorOnSurface"
                android:lineSpacingExtra="1sp"
                android:duplicateParentState="true"
                tools:text="Running (version 10)" />

        </LinearLayout>

        <TextView
            android:id="@android:id/text2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?textAppearanceLabelLarge"
            android:textColor="?colorOnSurfaceVariant"
            android:lineSpacingExtra="1sp"
            android:duplicateParentState="true" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/status_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/btn_activity_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_activity_log"
                android:visibility="gone"
                app:chipIcon="@drawable/ic_article_24"
                tools:visibility="visible" />

            <com.google.android.material.chip.Chip
                android:id="@+id/btn_diagnostics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_diagnostics_category"
                android:visibility="gone"
                app:chipIcon="@drawable/ic_server_ok_24"
                tools:visibility="visible" />

        </com.google.android.material.chip.ChipGroup>

        <!--
          Server controls. Outlined rather than filled: every surface role in this theme is the same
          pure black, so a filled button has no visible edge — ServerStatusViewHolder colours the
          stroke and text from the house accent.
        -->
        <!--
          Why this line exists: the server is a separate process from the app, and without saying so
          the obvious repair — force-stop and relaunch 白い熊 雫 — looks sufficient when it does
          nothing at all to the running server.
        -->
        <!-- The persistent stale-server warning. Coloured in code (RED) like every other warning
             here, because the generic View applier would otherwise flatten it to body text. Shown
             for as long as the condition holds, so dismissing the dialog does not hide the fact. -->
        <TextView
            android:id="@+id/server_stale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?textAppearanceBodySmall"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="⚠ The running server is from an older build. Restart it." />

        <TextView
            android:id="@+id/server_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?textAppearanceBodySmall"
            android:lineSpacingExtra="1sp"
            android:text="@string/home_status_server_info" />

        <LinearLayout
            android:id="@+id/server_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- Weighted, and allowed two lines: the label names the app, so it is long and must not
                 be ellipsised into "Restart 白い熊…" at large font scales. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_server_start"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:maxLines="2"
                android:text="@string/home_status_action_start"
                app:icon="@drawable/ic_server_start_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_server_stop"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text="@string/home_status_action_stop"
                android:visibility="gone"
                app:icon="@drawable/ic_close_24"
                tools:visibility="visible" />

        </LinearLayout>

        <!--
          In-flight indicator for start/stop. Its track must NOT be a surface role: every surface in
          this theme is the same pure black, so the unfilled portion would be invisible.
          ServerStatusViewHolder sets indicator=accent and track=minor border.
        -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/server_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>