<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card.Large">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@android:id/icon"
            style="@style/CardIcon.Droplet"
            android:duplicateParentState="true"
            android:importantForAccessibility="yes"
            android:contentDescription="@string/home_rish_title"
            android:src="@drawable/ic_terminal_24" />

        <TextView
            android:id="@android:id/text1"
            style="@style/CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/m3e_spacing_large"
            android:layout_weight="1"
            android:text="@string/home_rish_title" />

    </LinearLayout>

    <TextView
        android:id="@android:id/text2"
        style="@style/CardSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="@string/home_rish_summary_needs_setup" />

    <!-- OutlinedButton, matching the server card's Restart/Stop pills above it. NOT @style/CardButton:
         that fills with ?colorSecondaryContainer and carries no stroke, and in this theme every
         *Container role is the same pure black as the page — so it renders as bare text floating on
         the card instead of a button. Same trap as the standing "a container filled with a surface
         role must carry a visible border" rule; the outline is what makes the pill exist here. -->
    <com.google.android.material.button.MaterialButton
        android:id="@android:id/button1"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="@string/home_rish_button_copy"
        app:icon="@drawable/ic_code_24" />

</LinearLayout>
