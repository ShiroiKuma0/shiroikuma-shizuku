<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.AppTheme.Light" parent="Theme.Material3Expressive.Light.Shizuku">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>

        <item name="android:forceDarkAllowed">false</item>

        <item name="preferenceTheme">@style/AppTheme.PreferenceThemeOverlay</item>

        <item name="appColorPrimary">@color/app_color_light</item>

        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowActivityTransitions">true</item>
    </style>

    <style name="Theme.Light" parent="Base.AppTheme.Light" />

    <style name="Base.AppTheme" parent="Theme.Material3Expressive.Dark.Shizuku">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>

        <item name="android:forceDarkAllowed">false</item>

        <item name="preferenceTheme">@style/AppTheme.PreferenceThemeOverlay</item>
        
        <item name="appColorPrimary">@color/app_color_dark</item>

        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowActivityTransitions">true</item>
    </style>

    <style name="Theme" parent="Base.AppTheme.Light" />

    <style name="AppTheme.PreferenceThemeOverlay" parent="@style/PreferenceThemeOverlay.Rikka.Material3">
        <item name="switchPreferenceCompatStyle">@style/Preference.SwitchPreferenceCompat.M3Expressive</item>
        <item name="switchPreferenceStyle">@style/Preference.SwitchPreferenceCompat.M3Expressive</item>
        <item name="preferenceCategoryStyle">@style/Preference.Category.M3Expressive</item>
    </style>

    <style name="Preference.SwitchPreferenceCompat.M3Expressive" parent="@style/Preference.SwitchPreferenceCompat.Material">
        <item name="android:widgetLayout">@layout/preference_widget_material_switch</item>
    </style>
    
    <style name="Preference.Category.M3Expressive" parent="@style/Preference.Category.Material">
        <item name="allowDividerAbove">true</item>
        <item name="allowDividerBelow">false</item>
        <item name="android:layout">@layout/collapsible_preference_category_card</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- FORK: pure black, spelled out — NOT ?android:attr/colorBackground.
             The splash theme is applied by the SYSTEM before the Activity exists, so
             ThemeDelegateImpl has not yet layered ThemeOverlay.Shiroikuma on anything; the
             attribute therefore resolved against Theme.SplashScreen's own light parent and the
             splash came up GREY behind our black-and-yellow icon. A literal colour is the only
             thing that is correct this early. -->
        <item name="windowSplashScreenBackground">@color/shizuku_black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- Was Theme.Light — the LIGHT theme — which flashed white between the splash and the
             first frame. The house look is dark. -->
        <item name="postSplashScreenTheme">@style/Theme</item>
        <item name="android:windowBackground">@color/shizuku_black</item>
    </style>

    <!-- ===== 白い熊 雫 house dialog: black fill, YELLOW BORDER, yellow text and buttons. ===== -->
    <style name="Theme.Shiroikuma.Dialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <!-- Same olive trap as the app overlay: a dialog is an elevated surface. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="elevationOverlayColor">@color/shizuku_black</item>
        <item name="elevationOverlayAccentColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/shizuku_yellow</item>
        <item name="colorSurface">@color/shizuku_black</item>
        <item name="colorOnSurface">@color/shizuku_yellow</item>
        <item name="colorOnSurfaceVariant">@color/shizuku_yellow</item>
        <item name="colorSurfaceContainerHigh">@color/shizuku_black</item>
        <item name="android:textColorPrimary">@color/shizuku_yellow</item>
        <item name="android:textColorSecondary">@color/shizuku_yellow</item>
        <!-- AppCompat's select_dialog list layouts colour their text from the NON-android attr,
             so both have to be set or list dialogs come out grey. -->
        <item name="textColorAlertDialogListItem">@color/shizuku_yellow</item>
        <item name="android:textColorAlertDialogListItem">@color/shizuku_yellow</item>
        <item name="colorControlNormal">@color/shizuku_yellow</item>
        <item name="colorControlActivated">@color/shizuku_yellow</item>
        <item name="android:colorControlNormal">@color/shizuku_yellow</item>
        <item name="android:colorControlActivated">@color/shizuku_yellow</item>
        <item name="android:windowBackground">@drawable/shiroikuma_dialog_bg</item>
        <item name="buttonBarPositiveButtonStyle">@style/Theme.Shiroikuma.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Theme.Shiroikuma.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Theme.Shiroikuma.Dialog.Button</item>
    </style>

    <style name="Theme.Shiroikuma.Dialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/shizuku_yellow</item>
        <item name="rippleColor">@color/shizuku_yellow_dim</item>
    </style>

    <!-- ===== FORK: the house black-yellow baseline, applied LAST by ThemeDelegateImpl. ==========
         This is the static half of the 白い熊 雫 look: it puts pure black and pure yellow on every
         Material attribute, so every View screen and (because Compose reads the resolved Activity
         theme) every Compose screen comes up black-and-yellow with no user action.

         The live half is ShiroikumaTheme/ShiroikumaViewTheme, which layer the user's own knob
         values on top — a colour a slider just moved cannot live in a static resource.

         NOTE every *Container role is a FLAT near-black surface, never a low-alpha accent: Material
         composites containers as primary-over-surface, and yellow over black composites to OLIVE. -->
    <style name="ThemeOverlay.Shiroikuma" parent="">
        <item name="colorPrimary">@color/shizuku_yellow</item>
        <item name="colorOnPrimary">@color/shizuku_black</item>
        <item name="colorPrimaryContainer">@color/shizuku_black</item>
        <item name="colorOnPrimaryContainer">@color/shizuku_yellow</item>
        <item name="colorSecondary">@color/shizuku_yellow</item>
        <item name="colorOnSecondary">@color/shizuku_black</item>
        <item name="colorSecondaryContainer">@color/shizuku_black</item>
        <item name="colorOnSecondaryContainer">@color/shizuku_yellow</item>
        <item name="colorTertiary">@color/shizuku_yellow</item>
        <item name="colorOnTertiary">@color/shizuku_black</item>
        <item name="colorTertiaryContainer">@color/shizuku_black</item>
        <item name="colorOnTertiaryContainer">@color/shizuku_yellow</item>

        <item name="android:colorBackground">@color/shizuku_black</item>
        <item name="colorOnBackground">@color/shizuku_yellow</item>
        <item name="colorSurface">@color/shizuku_black</item>
        <item name="colorOnSurface">@color/shizuku_yellow</item>
        <item name="colorSurfaceVariant">@color/shizuku_black</item>
        <item name="colorOnSurfaceVariant">@color/shizuku_yellow_dim</item>
        <item name="colorSurfaceContainer">@color/shizuku_black</item>
        <item name="colorSurfaceContainerLow">@color/shizuku_black</item>
        <item name="colorSurfaceContainerLowest">@color/shizuku_black</item>
        <item name="colorSurfaceContainerHigh">@color/shizuku_black</item>
        <item name="colorSurfaceContainerHighest">@color/shizuku_black</item>
        <item name="colorSurfaceBright">@color/shizuku_black</item>
        <item name="colorSurfaceDim">@color/shizuku_black</item>
        <item name="colorSurfaceInverse">@color/shizuku_yellow</item>
        <item name="colorOnSurfaceInverse">@color/shizuku_black</item>

        <item name="colorOutline">@color/shizuku_yellow</item>
        <item name="colorOutlineVariant">@color/shizuku_grey</item>
        <item name="colorError">@color/shizuku_red</item>
        <item name="colorOnError">@color/shizuku_black</item>
        <item name="colorErrorContainer">@color/shizuku_black</item>
        <item name="colorOnErrorContainer">@color/shizuku_red</item>

        <!-- ⛔ THE OLIVE KILLER. Material's elevation overlay blends colorSurface with the
             elevation-overlay colour (colorPrimary by default) at an alpha derived from elevation.
             Black surface + yellow primary composites to a muddy GREEN — which is what every raised
             Material View surface (dialogs, cards, sheets, app bars) came out as. Compose is already
             covered by surfaceTint = Transparent in ShiroikumaTheme; this is the View-world twin.
             Never re-enable it while the palette is yellow-on-black. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="elevationOverlayColor">@color/shizuku_black</item>
        <item name="elevationOverlayAccentColor">@android:color/transparent</item>

        <item name="colorControlNormal">@color/shizuku_yellow</item>
        <item name="colorControlActivated">@color/shizuku_yellow</item>
        <item name="colorControlHighlight">@color/shizuku_yellow_dim</item>
        <item name="colorAccent">@color/shizuku_yellow</item>
        <item name="appColorPrimary">@color/shizuku_yellow</item>

        <item name="android:textColorPrimary">@color/shizuku_yellow</item>
        <item name="android:textColorSecondary">@color/shizuku_yellow_dim</item>
        <item name="android:textColorTertiary">@color/shizuku_yellow_dim</item>
        <item name="android:textColorHint">@color/shizuku_yellow_dim</item>
        <item name="android:windowBackground">@color/shizuku_black</item>

        <!-- Dialogs raised by upstream screens follow the house look too. -->
        <item name="alertDialogTheme">@style/Theme.Shiroikuma.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Shiroikuma.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.Shiroikuma.Dialog</item>
    </style>

</resources>
